# --- Supabase (Authentication + encrypted storage) -------------------
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Web Push (generic reminders at 09:00, 15:00, 21:00) -------------
# Generate once with:  npx web-push generate-vapid-keys
# Only the PUBLIC key goes here. The PRIVATE key is set as a secret of the
# send-reminders Edge Function and must never appear in this file.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Notes:
# - Without these variables the app runs in pure local mode (no account, no
#   sync), exactly like the original Daybook.
# - No encryption key, vault passphrase or recovery phrase ever appears in
#   any environment variable, log or database — by design.
